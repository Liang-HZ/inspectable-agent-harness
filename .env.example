OPENAI_API_KEY=sk-your-api-key

# Use this for OpenAI-compatible providers. Keep the /v1 suffix if the provider expects it.
OPENAI_BASE_URL=https://api.openai.com/v1

# For OpenAI this can be gpt-4o-mini; for compatible providers use their model id.
OPENAI_MODEL=gpt-4o-mini

# Agent provider wire protocol:
# - openai-chat-completions keeps the broad OpenAI-compatible path.
# - openai-responses uses OpenAI Responses API semantics.
OPENAI_WIRE_API=openai-chat-completions

# Where JSONL session rollouts are written. Defaults to data/agent-sessions.
# A relative value resolves against the process working directory. Tests set it
# to a temp directory so they never read or write the real transcripts.
# Note: the shell tool's read-only carveout below is the project-relative path
# data/agent-sessions, so moving the root elsewhere moves it out of that
# carveout.
# AGENT_SESSION_ROOT=data/agent-sessions

# The agent shell tool uses OS-level sandboxing in read_only and workspace_write
# modes: macOS sandbox-exec (/usr/bin/sandbox-exec) or Linux bubblewrap
# (/usr/bin/bwrap). If the platform sandbox binary is missing, the shell tool
# fails closed with EXECUTION_ERROR rather than running unsandboxed.
# danger_full_access bypasses the sandbox by explicit opt-in.
# No env variable toggles this; it is decided per run by sandboxMode.
